tion":null},{"id":"24ff4e38-2a28-4ff3-a13e-125d5c325175","question_id":"q06","model":"gemma-4-26b-a4b-it","condition":"uebai","rep":1,"prep_ms":145,"context_tokens_est":2687,"context_chars":7158,"topics":["تنوع بدائيات النوى"],"started_at":"2026-09-29T19:57:41.421Z","busy_rejections":0,"status":"ok","model_version":"gemma-4-26b-a4b-it","ttft_ms":25944,"total_ms":29280,"input_tokens":2915,"cached_tokens":0,"output_tokens":177,"thought_tokens":1171,"answer":"البدائيات المولدة لغاز الميثان تُعرف باسم \"المولدة للميثان\" (Methanogens)، وهي مخلوقات لاهوائية، أي أنها لا تستطيع العيش في وجود الأكسجين [ص 70]. وتستخدم هذه البدائيات ثاني أكسيد الكربون أثناء التنفس، وتخرج غاز الميثان باعتباره مخلفات أو فضلات [ص 70].\n\nتوجد هذه البدائيات في الأماكن التالية:\n- منشآت معالجة مياه المجاري [ص 70].\n- السبخات ومياه المستنقعات [ص 70].\n- بالقرب من فوهات البراكين في البحار [ص 70].\n- القناة الهضمية للإنسان والحيوان [ص 70].","recall":1,"cited_pages":[70],"page_hit":true,"abstained":false,"correct_abstention":null},{"id":"47415b7b-11e8-4a20-9117-c0ff12e79e9a","question_id":"q06","model":"gemma-4-26b-a4b-it","condition":"rag","rep":1,"prep_ms":1,"context_tokens_est":2774,"context_chars":7339,"started_at":"2026-09-29T19:58:10.972Z","busy_rejections":0,"status":"ok","model_version":"gemma-4-26b-a4b-it","ttft_ms":21131,"total_ms":24893,"input_tokens":3364,"cached_tokens":0,"output_tokens":190,"thought_tokens":936,"answer":"المجموعة المولدة لغاز الميثان (Methanogens) هي مجموعة من البدائيات، وهي مخلوقات لاهوائية (أي لا تستطيع العيش في وجود الأكسجين)؛ إذ تستخدم ثاني أكسيد الكربون في أثناء التنفس، وتخرج غاز الميثان باعتباره مخلفات [ص 70].\n\nوتوجد هذه البدائيات في الأماكن التالية:\n- منشآت معالجة مياه المجاري [ص 70].\n- السبخات [ص 70].\n- مياه المستنقعات [ص 70].\n- بالقرب من فوهات البراكين في البحار [ص 70].\n- القناة الهضمية للإنسان والحيوان، وهي مسؤولة عن الغازات التي تنطلق من الجزء السفلي من القناة الهضمية [ص 70].","recall":1,"cited_pages":[70],"page_hit":true,"abstained":false,"correct_abst