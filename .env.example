# Copy to .env.local and fill in. Without a key UEBAI runs in offline DEMO MODE
# (robots, library, ingestion and search all work; answers are canned/extractive).
ANTHROPIC_API_KEY=

# Or use Google Gemini for free (aistudio.google.com → Get API key). Used when no Anthropic key is set;
# force a choice with ROBOPROF_PROVIDER=gemini|anthropic. Gemini defaults: gemini-3.8-flash / gemini-3.5-flash-lite.
# GEMINI_API_KEY=

# Optional, for the Proof Lab (/bench): DeepSeek models (deepseek-flash, deepseek-v4-pro).
# Get a key at platform.deepseek.com (pay-as-you-go). Restart the site after adding it.
# DEEPSEEK_API_KEY=

# Optional model overrides (defaults shown)
# ROBOPROF_MODEL_TEACHER=claude-sonnet-5
# ROBOPROF_MODEL_NOTES=claude-sonnet-5
# ROBOPROF_MODEL_ROUTER=claude-haiku-4-5
# ROBOPROF_MODEL_DIGEST=claude-haiku-4-5

# Where the local JSON database + uploaded files live
# ROBOPROF_DATA_DIR=./data

# Hosting on Vercel: connect an Upstash Redis database to the project (Storage tab) and these are set
# for you. With them set, the database and uploads live in Redis instead of ROBOPROF_DATA_DIR.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Seconds of work per slice when hosted (must stay below the 300 s function limit).
# UEBAI_SLICE_SECONDS=200
